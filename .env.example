# Configuration du serveur
PORT=3000
NODE_ENV=development

# Base de données locale SQLite
DATABASE_URL=./data/chat.db

# Clé secrète pour signature des cookies / JWT de session (à changer en production)
SESSION_SECRET=change-this-to-a-very-long-and-secure-random-secret-key-32-chars

# Dossier de stockage des photos
UPLOAD_DIR=./uploads

# Clés Web Push VAPID (générées via `npm run vapid:generate`)
VAPID_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_VAPID
VAPID_PRIVATE_KEY=VOTRE_CLE_PRIVEE_VAPID
VAPID_SUBJECT=mailto:admin@votre-domaine.com

# Token de connexion Cloudflare Tunnel (optionnel pour l'exécution locale)
TUNNEL_TOKEN=VOTRE_TUNNEL_TOKEN_CLOUDFLARE
